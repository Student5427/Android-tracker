POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=run_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CREDENTIALS=${POSTGRES_USER}:${POSTGRES_PASSWORD}
DATABASE_URL=postgresql+asyncpg://${DB_CREDENTIALS}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

DB_ENGINE_POOL_PRE_PING=True
DB_ENGINE_POOL_RECYCLE=-1
DB_ENGINE_POOL_SIZE=5
DB_ENGINE_MAX_OVERFLOW=10
DB_ENGINE_POOL_TIMEOUT=30

API_SERVICE_PORT=8000