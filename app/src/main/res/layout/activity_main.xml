<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Кнопка справа сверху (динамическая) -->
    <LinearLayout
        android:id="@+id/todayButton"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">

        <ImageView
            android:id="@+id/todayButtonIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/icon" />

    </LinearLayout>

    <!-- Заголовок даты слева сверху -->
    <TextView
        android:id="@+id/dateTitle"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="24dp"
        android:layout_marginStart="27dp"
        android:text="Сегодня"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Контейнер для календаря -->
    <LinearLayout
        android:id="@+id/calendarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dateTitle"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Контейнер для календаря с кнопками навигации -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Кнопка предыдущей недели -->
            <TextView
                android:id="@+id/prevWeekBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="24sp"
                android:textColor="#525760"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <!-- Основной контейнер календаря -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Дни недели - фиксированные в XML -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="ПН"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="ВТ"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="СР"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="ЧТ"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="ПТ"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="СБ"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="ВС"
                        android:textSize="12sp"
                        android:textColor="#525760"
                        android:gravity="center"
                        android:layout_margin="4dp" />

                </LinearLayout>

                <!-- Даты месяца - прокручиваемые -->
                <HorizontalScrollView
                    android:id="@+id/calendarScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/calendarDaysLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Кнопка следующей недели -->
            <TextView
                android:id="@+id/nextWeekBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="›"
                android:textSize="24sp"
                android:textColor="#525760"
                android:gravity="center"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Кнопки режимов -->
    <LinearLayout
        android:id="@+id/modeButtonsLayout"
        android:layout_width="340dp"
        android:layout_height="40dp"
        android:layout_below="@id/calendarContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:background="@drawable/mode_buttons_background">

        <!-- Выполнено -->
        <LinearLayout
            android:id="@+id/completedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/left_button_background">

            <TextView
                android:id="@+id/completedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выполнено"
                android:textSize="14sp"
                android:textColor="#525760" />

        </LinearLayout>

        <!-- Запланированно -->
        <LinearLayout
            android:id="@+id/plannedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/right_button_background">

            <TextView
                android:id="@+id/plannedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Запланированно"
                android:textSize="14sp"
                android:textColor="#525760" />

        </LinearLayout>

    </LinearLayout>

    <!-- Область списка тренировок -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/modeButtonsLayout"
        android:layout_above="@id/bottomButtonsLayout"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/workoutListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Контейнер для нижних кнопок -->
    <LinearLayout
        android:id="@+id/bottomButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Новая черная кнопка "Запланировать тренировку" -->
        <LinearLayout
            android:id="@+id/planWorkoutButtonBlack"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/black_button_background"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Запланировать тренировку"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Кнопка начать тренировку -->
        <LinearLayout
            android:id="@+id/startWorkoutButton"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/orange_button_background"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Начать тренировку"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>